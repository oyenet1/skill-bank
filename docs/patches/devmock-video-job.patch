+#[cfg(test)]
+mod tests {
+    use super::*;
+    #[test]
+    fn one_minute_limit_is_enforced_by_native_session() {
+        assert!(!microphone_finished(959_998, 1, 16000, false).unwrap());
+        assert!(microphone_finished(959_999, 1, 16000, false).unwrap());
+        assert!(microphone_finished(959_999, 2, 16000, false).is_err());
+        assert!(microphone_finished(1, 0, 16000, true).unwrap());
+    }
+    #[test]
+    fn gpu_failure_falls_back_and_reports_actual_provider() {
+        let mut attempted = vec![];
+        let (_, provider, reason) = with_cpu_fallback(SpeechProvider::Auto, true, |provider| {
+            attempted.push(provider.to_owned());
+            (provider == "cpu").then_some(())
+        })
+        .unwrap();
+        assert_eq!(attempted, ["cuda", "cpu"]);
+        assert_eq!(provider, "cpu");
+        assert!(reason.is_some());
+        let (_, provider, _) = with_cpu_fallback(SpeechProvider::Cpu, true, |provider| {
+            assert_eq!(provider, "cpu");
+            Some(())
+        })
+        .unwrap();
+        assert_eq!(provider, "cpu");
+    }
+    #[test]
+    fn cpu_only_build_never_attempts_cuda() {
+        let (_, provider, reason) = with_cpu_fallback(SpeechProvider::Cuda, false, |provider| {
+            assert_eq!(provider, "cpu");
+            Some(())
+        })
+        .unwrap();
+        assert_eq!(provider, "cpu");
+        assert!(reason.is_some());
+    }
+    #[test]
+    fn validates_audio_before_native_inference() {
+        assert!(validate_samples(&[f32::NAN], 16000, 2).is_err());
+        assert!(validate_samples(&[0.0], 0, 2).is_err());
+        assert!(validate_samples(&vec![0.0; 32001], 16000, 2).is_err());
+        assert!(validate_samples(&vec![0.0; 32000], 16000, 2).is_ok());
+    }
+    #[test]
+    fn joins_partial_text_without_duplicating_committed_words() {
+        assert_eq!(joined_text("hello", "world"), "hello world");
+        assert_eq!(joined_text("hello", ""), "hello");
+    }
+    #[test]
+    fn streaming_model_smoke() {
+        let Some(dir) = std::env::var_os("AUDIO_STREAMING_MODEL_DIR") else {
+            return;
+        };
+        let dir = std::path::PathBuf::from(dir);
+        let recognizer = create_online(&dir, "cpu").expect("load streaming model");
+        let mut reader = hound::WavReader::open(dir.join("test_wavs/0.wav")).unwrap();
+        let sample_rate = reader.spec().sample_rate as i32;
+        let samples: Vec<f32> = reader
+            .samples::<i16>()
+            .map(|sample| sample.unwrap() as f32 / 32768.0)
+            .collect();
+        let mut session = LiveSession {
+            id: "test".into(),
+            stream: recognizer.create_stream(),
+            recognizer,
+            provider: "cpu".into(),
+            fallback_reason: None,
+            committed: String::new(),
+            segments: vec![],
+            elapsed: 0.0,
+            utterance_start: 0.0,
+            sample_rate,
+            total_samples: 0,
+        };
+        let mut saw_partial = false;
+        for chunk in samples.chunks((sample_rate / 4) as usize) {
+            let update = session.update(chunk, false).unwrap();
+            saw_partial |= !update.text.is_empty();
+        }
+        let result = session.update(&[], true).unwrap();
+        assert!(saw_partial, "text must appear before finishing");
+        assert!(!result.text.trim().is_empty());
+        assert!(!result.segments.is_empty());
+        assert_eq!(result.provider, "cpu");
+        println!("Streaming transcript: {}", result.text);
+    }
+}
