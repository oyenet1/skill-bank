+fn remotion_browser_ready(profile: &Path, node: &Path) -> bool {
+    let mut command = Command::new(node);
+    command.current_dir(profile).args([
+        "-e",
+        "const {ensureBrowser}=require('@remotion/renderer');ensureBrowser({logLevel:'error',onBrowserDownload:()=>{throw Error('browser missing')}}).then(()=>process.stdout.write('ready')).catch(()=>process.exit(1))",
+    ]);
+    tool_environment(&mut command, node);
+    command.output().is_ok_and(|output| {
+        output.status.success() && String::from_utf8_lossy(&output.stdout).trim() == "ready"
+    })
+}
+
+/// Bound independent installs; join every worker before reporting failure or readiness.
+fn run_setup_tasks<T: Send>(
+    tasks: Vec<Box<dyn FnOnce() -> Result<T, String> + Send + '_>>,
+) -> Result<Vec<T>, String> {
+    let mut pending = tasks.into_iter();
+    let mut results = Vec::new();
+    let mut errors = Vec::new();
+    loop {
+        let batch: Vec<_> = pending.by_ref().take(4).collect();
+        if batch.is_empty() {
+            break;
+        }
+        thread::scope(|scope| {
+            let workers: Vec<_> = batch.into_iter().map(|task| scope.spawn(task)).collect();
+            for worker in workers {
+                match worker.join() {
+                    Ok(Ok(result)) => results.push(result),
+                    Ok(Err(error)) => errors.push(error),
+                    Err(_) => errors.push("Video setup worker panicked".into()),
+                }
+            }
+        });
+        if !errors.is_empty() {
+            break;
+        }
+    }
+    if errors.is_empty() {
+        Ok(results)
+    } else {
+        Err(errors.join("; "))
+    }
 }
 
