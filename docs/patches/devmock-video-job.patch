+import { beforeEach, afterEach, describe, expect, it, vi } from 'vitest';
+import { File } from 'node:buffer';
+import { runVideoProject, type VideoProjectOptions, type GeneratedSceneAsset } from './videoProject';
+
+const mocks = vi.hoisted(() => ({ invoke: vi.fn() }));
+vi.mock('@tauri-apps/api/core', () => ({ invoke: mocks.invoke, isTauri: () => true, Channel: class { onmessage?: unknown } }));
+vi.mock('./rustExport', () => ({ getFfmpegStatus: async () => ({ installed: true }), getFfprobeStatus: async () => ({ installed: true }), installFfmpeg: vi.fn() }));
+
+class TestImage {
+  naturalWidth = 1024; naturalHeight = 1024; onload?: () => void;
+  set src(_value: string) { queueMicrotask(() => this.onload?.()); }
+}
+class TestReader {
+  result: string | null = null; onload?: () => void;
+  readAsDataURL(blob: Blob) { void blob.arrayBuffer().then(data => { this.result = `data:image/png;base64,${Buffer.from(data).toString('base64')}`; this.onload?.(); }); }
+}
+const provenance = { provider: 'openai', model: 'gpt-image-2', prompt: 'fixture illustration', size: '1536x1024', quality: 'medium', createdAt: '2026-09-30', sha256: 'fixture', sourceType: 'generated', rightsReviewRequired: true, termsUrl: 'https://openai.com/policies/terms-of-use/' };
+function options(): VideoProjectOptions {
+  return {
+    plan: { title: 'Illustrated explainer', category: 'explainer', aspect: '16:9', platform: 'Website', durationSec: 1, fps: 30, tone: 'Friendly', cta: '', audience: 'Teams', language: 'en', captions: true, productionPrompt: 'Explain the idea', scenes: [
+      { id: 's1', durationSec: 1, template: 'hook-card', visual: 'A simple landscape illustration', screenText: 'An idea', voiceover: '', transition: 'cut' },
+    ] },
+    images: [], imageByScene: { s1: -1 }, narrationByScene: {}, clipByScene: {}, voiceEnabled: false, voice: '', voiceSpeed: 1,
+    primary: '#123456', surface: '#000000', text: '#ffffff', headlineFont: 'Inter', bodyFont: 'Inter', fps: 30,
+    imageGeneration: { model: 'gpt-image-2', quality: 'medium', getKey: async () => 'ephemeral-test-secret', cache: new Map<string, GeneratedSceneAsset>() },
+  };
+}
+
+beforeEach(() => {
+  mocks.invoke.mockReset();
+  vi.stubGlobal('File', File); vi.stubGlobal('Image', TestImage); vi.stubGlobal('FileReader', TestReader);
+  const context = { fillRect: vi.fn(), drawImage: vi.fn(), createLinearGradient: () => ({ addColorStop: vi.fn() }), fillText: vi.fn(), measureText: () => ({ width: 10 }) };
+  vi.stubGlobal('document', { createElement: () => ({ getContext: () => context, toDataURL: () => 'data:image/png;base64,aW1hZ2U=' }) });
+  mocks.invoke.mockImplementation(async command => command === 'video_skill_generate_image' ? { ready: true, dataBase64: 'aW1hZ2U=', provenance } : { directory: '/fixture/project' });
+});
+afterEach(() => { vi.unstubAllGlobals(); });
+
+describe('generated scene image handoff', () => {
+  it('reuses completed assets, records provenance and excludes the key from the render request', async () => {
+    const config = options();
+    await runVideoProject(config, () => {}, { value: false });
+    await runVideoProject(config, () => {}, { value: false });
+    expect(mocks.invoke.mock.calls.filter(call => call[0] === 'video_skill_generate_image')).toHaveLength(1);
+    const requests = mocks.invoke.mock.calls.filter(call => call[0] === 'video_skill_render').map(call => call[1].request);
+    expect(requests).toHaveLength(2);
+    expect(requests[0].sourceAssets[0].provenance).toEqual(provenance);
+    expect(requests[0].scenes[0].sourceAssetIndex).toBe(0);
+    expect(JSON.stringify(requests)).not.toContain('ephemeral-test-secret');
+    expect(config.images).toHaveLength(0);
+  });
+
+  it('stops before another provider call or video render when cancelled', async () => {
+    const config = options();
+    config.plan.scenes.push({ ...config.plan.scenes[0], id: 's2', visual: 'A different illustration' });
+    const cancelled = { value: false };
+    mocks.invoke.mockImplementation(async command => {
+      if (command === 'video_skill_generate_image') { cancelled.value = true; return { ready: true, dataBase64: 'aW1hZ2U=', provenance }; }
+      throw new Error('No render should start');
+    });
+    await expect(runVideoProject(config, () => {}, cancelled)).rejects.toThrow('cancelled');
+    expect(mocks.invoke).toHaveBeenCalledTimes(1);
+  });
+
+  it('requires a portrait workflow to turn off scene image generation before spending', async () => {
+    const config = options(); config.avatar = { enabled: true, ready: true, backend: 'musetalk-15', image: null, rightsConfirmed: true };
+    await expect(runVideoProject(config, () => {}, { value: false })).rejects.toThrow('Disable scene illustrations');
+    expect(mocks.invoke).not.toHaveBeenCalled();
+  });
+});
