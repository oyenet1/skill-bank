+// npm creates batch wrappers on Windows. Run their declared JavaScript entry
+// through Node so user paths and arguments never pass through a command shell.
+fn tool_command(binary: &Path, node: &Path) -> Result<Command, String> {
+    if !cfg!(windows) || binary.extension().and_then(|v| v.to_str()) != Some("cmd") {
+        return Ok(Command::new(binary));
+    }
+    let name = binary
+        .file_stem()
+        .and_then(|v| v.to_str())
+        .ok_or("Invalid tool name")?;
+    let parent = binary.parent().ok_or("Tool has no parent directory")?;
+    let package = match name {
+        "npm" => parent.join("node_modules/npm"),
+        "slidev" => parent.join("../@slidev/cli"),
+        "remotion" => parent.join("../@remotion/cli"),
+        "hyperframes" => parent.join("../hyperframes"),
+        "playwright" => parent.join("../playwright-chromium"),
+        _ => return Err(format!("Unsupported Windows video tool: {name}")),
+    };
+    let metadata: Value = serde_json::from_slice(
+        &fs::read(package.join("package.json"))
+            .map_err(|e| format!("Missing {name} package metadata: {e}"))?,
+    )
+    .map_err(|e| format!("Invalid {name} package metadata: {e}"))?;
+    let entry = metadata["bin"]
+        .as_str()
+        .or_else(|| metadata["bin"][name].as_str())
+        .ok_or_else(|| format!("Missing {name} JavaScript entry point"))?;
+    let entry = package.join(entry);
+    if !entry.is_file() {
+        return Err(format!("Missing {name} entry point: {}", entry.display()));
+    }
+    let mut command = Command::new(node);
+    command.arg(entry);
+    Ok(command)
+}
