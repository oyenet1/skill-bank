+++ b/src/components/LocalAvatarPanel.vue
@@ -0,0 +1,109 @@
+<script setup lang="ts">
+import { computed, ref, watch } from 'vue';
+import { Channel, invoke } from '@tauri-apps/api/core';
+import type { LocalAvatarOptions } from '../engine/videoProject';
+
+defineProps<{ disabled?: boolean }>();
+const model = defineModel<LocalAvatarOptions>({ required: true });
+interface Candidate {
+  id: string; displayName: string; license: string; licenseClass: string;
+  componentLicenses: string[]; downloadBytes: number; diskBytes: number;
+  recommendedMaxSeconds: number; estimatedSecondsPerSecond: number[]; consentToken: string; dependencyDownloads: string;
+}
+interface Setup {
+  ready: boolean; error?: string; reason?: string; installedBackends: string[];
+  capability: { os: string; arch: string; eligible: boolean; reason: string;
+    accelerator: { kind: string; name: string | null; memoryBytes: number } };
+  consent: { candidates: Candidate[] };
+}
+const busy = ref(false);
+const setup = ref<Setup | null>(null);
+const selected = ref('');
+const accepted = ref(false);
+const allowRestricted = ref(false);
+const error = ref('');
+const progress = ref('');
+const gib = (bytes: number) => `${(bytes / 1024 ** 3).toFixed(1)} GiB`;
+const candidates = computed(() => setup.value?.consent.candidates ?? []);
+const candidate = computed(() => candidates.value.find(row => row.id === selected.value));
+const installed = computed(() => setup.value?.installedBackends.includes(selected.value) ?? false);
+watch([selected, installed], () => {
+  accepted.value = false;
+  model.value = { ...model.value, backend: selected.value, ready: installed.value };
+});
+async function operation(install = false) {
+  if (install && (!accepted.value || !candidate.value)) return;
+  busy.value = true;
+  model.value = { ...model.value, ready: false };
+  error.value = '';
+  progress.value = install ? 'Preparing the selected presenter…' : 'Checking local presenter hardware and installed files…';
+  const channel = new Channel<{ phase: string; message: string; details?: { downloadedBytes?: number; totalBytes?: number } }>();
+  channel.onmessage = value => {
+    const bytes = value.details;
+    progress.value = value.message + (bytes?.totalBytes ? ` (${gib(bytes.downloadedBytes ?? 0)} / ${gib(bytes.totalBytes)})` : '');
+  };
+  try {
+    const result = await invoke<Setup>(install ? 'video_skill_avatar_install' : 'video_skill_avatar_probe', {
+      ...(install ? { backend: selected.value, consentToken: candidate.value!.consentToken, accept: true, allowRestricted: allowRestricted.value } : { allowRestricted: allowRestricted.value }),
+      onProgress: channel,
+    });
+    setup.value = result;
+    if (!selected.value || !result.consent.candidates.some(row => row.id === selected.value)) {
+      selected.value = result.installedBackends[0] ?? result.consent.candidates[0]?.id ?? '';
+    }
+    model.value = { ...model.value, backend: selected.value, ready: result.installedBackends.includes(selected.value) };
+    if (install && !result.ready) error.value = result.error ?? result.reason ?? 'Inference verification did not finish. Retry after reviewing the progress log.';
+  } catch (value) {
+    error.value = String(value);
+  } finally {
+    busy.value = false;
+  }
+}
+function portrait(event: Event) {
+  const file = (event.target as HTMLInputElement).files?.[0] ?? null;
+  if (file && (!['image/png', 'image/jpeg', 'image/webp'].includes(file.type) || file.size > 22_000_000)) {
+    error.value = 'Use a PNG, JPEG or WebP portrait under 22 MB.';
+    (event.target as HTMLInputElement).value = '';
+    return;
+  }
+  model.value = { ...model.value, image: file, rightsConfirmed: false };
+}
+async function cancel() { await invoke('video_skill_cancel'); }
+</script>
+
+<template>
+  <section class="space-y-3 rounded-lg border border-default p-3">
+    <h3 class="text-sm font-semibold text-highlighted">Local photo presenter</h3>
+    <p class="text-xs text-muted">Animate your portrait with local narration. NVIDIA needs 6 GiB GPU memory; Apple Silicon needs 24 GiB unified memory. Other computers can use uploaded footage.</p>
+    <UCheckbox v-model="model.enabled" label="Generate a presenter from a portrait" :disabled="disabled || busy" />
+    <template v-if="model.enabled">
+      <UCheckbox v-model="allowRestricted" label="Include models with additional licence restrictions" :disabled="disabled || busy" @update:model-value="setup = null; model.ready = false; accepted = false" />
+      <UButton label="Check this computer" icon="i-lucide-cpu" size="sm" variant="soft" :loading="busy" :disabled="disabled || busy" @click="operation()" />
+      <UButton v-if="busy" label="Cancel" color="neutral" variant="soft" size="sm" @click="cancel" />
+      <p v-if="busy" class="text-xs text-muted" role="status">{{ progress }}</p>
+      <UAlert v-if="error" color="error" variant="subtle" :description="error" />
+      <template v-if="setup">
+        <p class="text-xs text-muted">{{ setup.capability.os }} {{ setup.capability.arch }} · {{ setup.capability.accelerator.name || setup.capability.accelerator.kind }} · {{ gib(setup.capability.accelerator.memoryBytes) }}</p>
+        <UAlert v-if="!setup.capability.eligible" color="warning" variant="subtle" :description="`Local generation unavailable: ${setup.capability.reason}. Use uploaded footage or a storyboard with narration.`" />
+        <UFormField v-if="candidates.length" label="Presenter backend">
+          <USelectMenu v-model="selected" value-key="id" label-key="displayName" :items="candidates" :disabled="disabled || busy" class="w-full" />
+        </UFormField>
+        <template v-if="candidate && !installed">
+          <p class="text-xs text-muted">Download {{ gib(candidate.downloadBytes) }} · Disk allowance {{ gib(candidate.diskBytes) }}. {{ candidate.dependencyDownloads }}.</p>
+          <p class="text-xs text-muted">Estimated {{ candidate.estimatedSecondsPerSecond.join('–') }} seconds of processing per second of narration; resolution and accelerator affect this estimate.</p>
+          <p class="text-xs text-muted">{{ candidate.license }} · {{ candidate.componentLicenses.join(', ') }}</p>
+          <UCheckbox v-model="accepted" label="I accept these component licences and model downloads" :disabled="disabled || busy" />
+          <UButton label="Accept and install presenter" size="sm" :disabled="disabled || busy || !accepted" @click="operation(true)" />
+        </template>
+        <template v-if="installed">
+          <UAlert color="success" variant="subtle" description="Presenter files and runtime verified. Inference runs locally without network access." />
+          <UFormField label="Portrait" description="Upload a clear front-facing PNG, JPEG or WebP portrait.">
+            <input type="file" accept="image/png,image/jpeg,image/webp" :disabled="disabled || busy" class="w-full text-sm" @change="portrait" />
+          </UFormField>
+          <UCheckbox v-model="model.rightsConfirmed" label="I have permission to animate this person's image" :disabled="disabled || busy || !model.image" />
+          <p class="text-xs text-muted">Enable narration or upload audio for every scene. Clips up to {{ candidate?.recommendedMaxSeconds ?? 30 }} seconds are recommended. Resolution and hardware affect speed; long scenes may take several minutes.</p>
+        </template>
+      </template>
+    </template>
+  </section>
+</template>
