+use crate::audio_studio::{self, TimedTranscript, TranscriptSegment};
+use serde::{Deserialize, Serialize};
+use sherpa_onnx::{
+    OfflineRecognizer, OfflineRecognizerConfig, OnlineRecognizer, OnlineRecognizerConfig,
+    OnlineStream,
+};
+use std::{path::Path, sync::Mutex};
+use tauri::{AppHandle, Manager};
+
+#[derive(Clone, Copy, Debug, Default, Deserialize, PartialEq)]
+#[serde(rename_all = "lowercase")]
+pub enum SpeechProvider {
+    #[default]
+    Auto,
+    Cpu,
+    Cuda,
+}
+
+#[derive(Default)]
+pub struct SpeechState {
+    whisper: Mutex<Option<CachedWhisper>>,
+    live: Mutex<LiveRegistry>,
+}
+struct CachedWhisper {
+    key: String,
+    recognizer: OfflineRecognizer,
+    provider: String,
+    fallback_reason: Option<String>,
+}
+#[derive(Default)]
+struct LiveRegistry {
+    requested: Option<String>,
+    session: Option<LiveSession>,
+}
+struct LiveSession {
+    id: String,
+    // Drop the stream before its recognizer.
+    stream: OnlineStream,
+    recognizer: OnlineRecognizer,
+    provider: String,
+    fallback_reason: Option<String>,
+    committed: String,
+    segments: Vec<TranscriptSegment>,
+    elapsed: f32,
+    utterance_start: f32,
+    sample_rate: i32,
+    total_samples: usize,
+}
+
+/// Only CUDA-enabled builds probe the NVIDIA driver. CPU packages never load it.
+pub fn cuda_available() -> bool {
+    #[cfg(feature = "speech-cuda")]
+    {
+        static AVAILABLE: std::sync::OnceLock<bool> = std::sync::OnceLock::new();
+        *AVAILABLE.get_or_init(|| unsafe {
+            #[cfg(target_os = "windows")]
+            let name = "nvcuda.dll";
+            #[cfg(not(target_os = "windows"))]
+            let name = "libcuda.so.1";
+            let Ok(driver) = libloading::Library::new(name) else {
+                return false;
+            };
+            let Ok(init) = driver.get::<unsafe extern "system" fn(u32) -> i32>(b"cuInit\0") else {
+                return false;
+            };
+            let Ok(count) =
+                driver.get::<unsafe extern "system" fn(*mut i32) -> i32>(b"cuDeviceGetCount\0")
+            else {
+                return false;
+            };
+            let mut devices = 0;
+            if init(0) != 0 || count(&mut devices) != 0 || devices == 0 {
+                return false;
+            }
+            // A driver alone is insufficient: CUDA/cuDNN dependencies must load too.
+            #[cfg(target_os = "windows")]
+            let (shared, cuda) = (
+                "onnxruntime_providers_shared.dll",
+                "onnxruntime_providers_cuda.dll",
+            );
+            #[cfg(not(target_os = "windows"))]
+            let (shared, cuda) = (
+                "libonnxruntime_providers_shared.so",
+                "libonnxruntime_providers_cuda.so",
+            );
+            let executable_dir = std::env::current_exe()
+                .ok()
+                .and_then(|exe| exe.parent().map(Path::to_path_buf));
+            let build_dir = std::path::PathBuf::from(env!("PROGRAVITY_SPEECH_LIB_DIR"));
+            executable_dir
+                .into_iter()
+                .chain(std::iter::once(build_dir))
+                .any(|dir| {
+                    let Ok(_shared) = libloading::Library::new(dir.join(shared)) else {
+                        return false;
+                    };
+                    libloading::Library::new(dir.join(cuda)).is_ok()
+                })
+        })
+    }
+    #[cfg(not(feature = "speech-cuda"))]
+    {
+        false
+    }
+}
+
+fn provider_plan(request: SpeechProvider, available: bool) -> (&'static str, Option<String>) {
+    match (request, available) {
+        (SpeechProvider::Cpu, _) | (SpeechProvider::Auto, false) => ("cpu", None),
+        (SpeechProvider::Auto | SpeechProvider::Cuda, true) => ("cuda", None),
+        (SpeechProvider::Cuda, false) => (
+            "cpu",
+            Some("GPU acceleration is unavailable; using CPU.".into()),
+        ),
+    }
+}
+
+fn model_file(dir: &Path, stem: &str, provider: &str) -> Option<String> {
+    // CUDA benefits from floating point models; CPU benefits from quantization.
+    let names = if provider == "cuda" {
+        [format!("{stem}.onnx"), format!("{stem}.int8.onnx")]
+    } else {
+        [format!("{stem}.int8.onnx"), format!("{stem}.onnx")]
+    };
+    names
+        .iter()
+        .map(|name| dir.join(name))
+        .find(|path| path.is_file())
+        .map(|path| path.to_string_lossy().into_owned())
+}
+
+fn cpu_threads() -> i32 {
+    std::thread::available_parallelism()
+        .map(|count| count.get().min(4) as i32)
+        .unwrap_or(2)
+}
+
+pub(crate) fn create_online(dir: &Path, provider: &str) -> Option<OnlineRecognizer> {
+    let mut config = OnlineRecognizerConfig::default();
+    config.model_config.transducer.encoder = model_file(dir, "encoder-epoch-99-avg-1", provider);
+    config.model_config.transducer.decoder = model_file(dir, "decoder-epoch-99-avg-1", provider);
+    config.model_config.transducer.joiner = model_file(dir, "joiner-epoch-99-avg-1", provider);
+    config.model_config.tokens = Some(dir.join("tokens.txt").to_string_lossy().into_owned());
+    config.model_config.provider = Some(provider.into());
+    config.model_config.num_threads = cpu_threads();
+    config.decoding_method = Some("greedy_search".into());
+    config.enable_endpoint = true;
+    OnlineRecognizer::create(&config)
+}
+
+fn create_whisper(
+    dir: &Path,
+    pack: &str,
+    language: &str,
+    translate: bool,
+    provider: &str,
+) -> Option<OfflineRecognizer> {
+    let prefix = pack.strip_prefix("sherpa-onnx-whisper-")?;
+    let mut config = OfflineRecognizerConfig::default();
+    config.model_config.whisper.encoder = model_file(dir, &format!("{prefix}-encoder"), provider);
+    config.model_config.whisper.decoder = model_file(dir, &format!("{prefix}-decoder"), provider);
+    config.model_config.whisper.language = (language != "auto").then(|| language.into());
+    config.model_config.whisper.task =
+        Some(if translate { "translate" } else { "transcribe" }.into());
+    config.model_config.whisper.enable_token_timestamps = true;
+    config.model_config.tokens = Some(
+        dir.join(format!("{prefix}-tokens.txt"))
+            .to_string_lossy()
+            .into_owned(),
+    );
+    config.model_config.provider = Some(provider.into());
+    config.model_config.num_threads = cpu_threads();
+    OfflineRecognizer::create(&config)
+}
+
+fn with_cpu_fallback<T>(
+    request: SpeechProvider,
+    available: bool,
+    mut create: impl FnMut(&str) -> Option<T>,
+) -> Result<(T, String, Option<String>), String> {
+    let (provider, fallback) = provider_plan(request, available);
+    if let Some(engine) = create(provider) {
+        return Ok((engine, provider.into(), fallback));
+    }
+    if provider == "cuda" {
+        if let Some(engine) = create("cpu") {
+            return Ok((
+                engine,
+                "cpu".into(),
+                Some("GPU initialization failed; using CPU.".into()),
+            ));
+        }
+    }
+    Err("Could not load the speech model. Check that the model is installed correctly.".into())
+}
+
+fn validate_samples(samples: &[f32], sample_rate: i32, max_seconds: usize) -> Result<(), String> {
+    if !(8_000..=192_000).contains(&sample_rate)
+        || samples.is_empty()
+        || samples.len() > sample_rate as usize * max_seconds
+        || samples.iter().any(|sample| !sample.is_finite())
+    {
+        return Err("Invalid or oversized audio samples".into());
+    }
+    Ok(())
+}
+
+fn microphone_finished(
+    total_samples: usize,
+    chunk_samples: usize,
+    sample_rate: i32,
+    requested_finish: bool,
+) -> Result<bool, String> {
+    let maximum = sample_rate as usize * 60;
+    if total_samples.saturating_add(chunk_samples) > maximum {
+        return Err("Microphone sessions are limited to one minute".into());
+    }
+    Ok(requested_finish || total_samples + chunk_samples == maximum)
+}
+
+pub(crate) fn transcribe(
+    app: &AppHandle,
+    pack: &str,
+    samples: &[f32],
+    sample_rate: i32,
+    language: &str,
+    translate: bool,
+    request: SpeechProvider,
+) -> Result<TimedTranscript, String> {
+    validate_samples(samples, sample_rate, 30 * 60)?;
+    if !matches!(
+        pack,
+        "sherpa-onnx-whisper-tiny" | "sherpa-onnx-whisper-base" | "sherpa-onnx-whisper-small"
+    ) {
+        return Err("Choose a Whisper model".into());
+    }
+    let dir = audio_studio::model_dir(app, pack)?;
+    if !audio_studio::ready(&dir, "stt") {
+        return Err("Install the Whisper model first".into());
+    }
+    let key = format!("{pack}:{language}:{translate}:{request:?}");
+    let state = app.state::<SpeechState>();
+    let mut cache = state
+        .whisper
+        .lock()
+        .map_err(|_| "Speech engine lock failed")?;
+    if cache.as_ref().map(|cached| cached.key.as_str()) != Some(key.as_str()) {
+        // Free the previous model before allocating a larger one.
+        *cache = None;
+        let (recognizer, provider, fallback_reason) =
+            with_cpu_fallback(request, cuda_available(), |provider| {
+                create_whisper(&dir, pack, language, translate, provider)
+            })?;
+        *cache = Some(CachedWhisper {
+            key,
+            recognizer,
+            provider,
+            fallback_reason,
+        });
+    }
+    let cached = cache.as_ref().ok_or("Speech engine unavailable")?;
+    let stream = cached.recognizer.create_stream();
+    stream.accept_waveform(sample_rate, samples);
+    cached.recognizer.decode(&stream);
+    let result = stream.get_result().ok_or("No transcript returned")?;
+    let timed = result
+        .timestamps
+        .as_ref()
+        .map(|timestamps| audio_studio::build_segments(&result.tokens, timestamps))
+        .unwrap_or_default();
+    let timing_approximate = timed.is_empty();
+    let segments = if timing_approximate {
+        audio_studio::estimate_segments(&result.text, samples.len() as f32 / sample_rate as f32)
+    } else {
+        timed
+    };
+    Ok(TimedTranscript {
+        text: result.text,
+        segments,
+        timing_approximate,
+        provider: cached.provider.clone(),
+        fallback_reason: cached.fallback_reason.clone(),
+    })
+}
+
+#[derive(Serialize)]
+pub struct LiveUpdate {
+    finished: bool,
+    text: String,
+    segments: Vec<TranscriptSegment>,
+    provider: String,
+    fallback_reason: Option<String>,
+}
+
+impl LiveSession {
+    fn update(&mut self, samples: &[f32], finish: bool) -> Result<LiveUpdate, String> {
+        self.total_samples += samples.len();
+        self.elapsed = self.total_samples as f32 / self.sample_rate as f32;
+        if !samples.is_empty() {
+            self.stream.accept_waveform(self.sample_rate, samples);
+        }
+        if finish {
+            // The transducer needs trailing context to decode the last spoken word.
+            self.stream.accept_waveform(
+                self.sample_rate,
+                &vec![0.0; (self.sample_rate / 2) as usize],
+            );
+            self.stream.input_finished();
+        }
+        while self.recognizer.is_ready(&self.stream) {
+            self.recognizer.decode(&self.stream);
+        }
+        let partial = self
+            .recognizer
+            .get_result(&self.stream)
+            .ok_or("No live transcript returned")?
+            .text
+            .trim()
+            .to_owned();
+        let endpoint = finish || self.recognizer.is_endpoint(&self.stream);
+        if endpoint {
+            if !partial.is_empty() {
+                self.committed = joined_text(&self.committed, &partial);
+                self.segments.push(TranscriptSegment {
+                    start: self.utterance_start,
+                    end: self.elapsed,
+                    text: partial.clone(),
+                });
+            }
+            if !finish {
+                self.recognizer.reset(&self.stream);
+            }
+            self.utterance_start = self.elapsed;
+        }
+        Ok(LiveUpdate {
+            finished: finish,
+            text: if endpoint {
+                self.committed.clone()
+            } else {
+                joined_text(&self.committed, &partial)
+            },
+            segments: self.segments.clone(),
+            provider: self.provider.clone(),
+            fallback_reason: self.fallback_reason.clone(),
+        })
+    }
+}
+fn joined_text(committed: &str, partial: &str) -> String {
+    [committed.trim(), partial.trim()]
+        .into_iter()
+        .filter(|text| !text.is_empty())
+        .collect::<Vec<_>>()
+        .join(" ")
+}
+
+#[tauri::command(async)]
+pub async fn speech_live_start(
+    app: AppHandle,
+    session_id: String,
+    sample_rate: i32,
+    provider: Option<SpeechProvider>,
+) -> Result<LiveUpdate, String> {
+    if session_id.is_empty() || session_id.len() > 128 || !(8_000..=192_000).contains(&sample_rate)
+    {
+        return Err("Invalid microphone session".into());
+    }
+    {
+        let state = app.state::<SpeechState>();
+        let mut registry = state
+            .live
+            .lock()
+            .map_err(|_| "Speech session lock failed")?;
+        registry.requested = Some(session_id.clone());
+        registry.session = None;
+    }
+    tauri::async_runtime::spawn_blocking(move || {
+        let dir = audio_studio::model_dir(&app, audio_studio::LIVE_PACK)?;
+        if !audio_studio::ready(&dir, "stt-live") {
+            return Err("Download the Live English model first".into());
+        }
+        let (recognizer, provider, fallback_reason) =
+            with_cpu_fallback(provider.unwrap_or_default(), cuda_available(), |provider| {
+                create_online(&dir, provider)
+            })?;
+        let initial = LiveUpdate {
+            finished: false,
+            text: String::new(),
+            segments: vec![],
+            provider: provider.clone(),
+            fallback_reason: fallback_reason.clone(),
+        };
+        let session = LiveSession {
+            id: session_id.clone(),
+            stream: recognizer.create_stream(),
+            recognizer,
+            provider,
+            fallback_reason,
+            committed: String::new(),
+            segments: vec![],
+            elapsed: 0.0,
+            utterance_start: 0.0,
+            sample_rate,
+            total_samples: 0,
+        };
+        let state = app.state::<SpeechState>();
+        let mut registry = state
+            .live
+            .lock()
+            .map_err(|_| "Speech session lock failed")?;
+        if registry.requested.as_deref() != Some(&session_id) {
+            return Err("Microphone session cancelled".into());
+        }
+        registry.session = Some(session);
+        Ok(initial)
+    })
+    .await
+    .map_err(|error| error.to_string())?
+}
+
+#[tauri::command(async)]
+pub async fn speech_live_feed(
+    app: AppHandle,
+    session_id: String,
+    samples: Vec<f32>,
+    finish: bool,
+) -> Result<LiveUpdate, String> {
+    tauri::async_runtime::spawn_blocking(move || {
+        let state = app.state::<SpeechState>();
+        let mut registry = state
+            .live
+            .lock()
+            .map_err(|_| "Speech session lock failed")?;
+        let session = registry
+            .session
+            .as_mut()
+            .filter(|session| session.id == session_id)
+            .ok_or("Microphone session is no longer active")?;
+        if !samples.is_empty() {
+            validate_samples(&samples, session.sample_rate, 2)?;
+        } else if !finish {
+            return Err("Empty microphone audio".into());
+        }
+        let finish = microphone_finished(
+            session.total_samples,
+            samples.len(),
+            session.sample_rate,
+            finish,
+        )?;
+        let result = session.update(&samples, finish);
+        if finish {
+            registry.session = None;
+            registry.requested = None;
+        }
+        result
+    })
+    .await
+    .map_err(|error| error.to_string())?
+}
+
+#[tauri::command(async)]
+pub async fn speech_live_cancel(app: AppHandle, session_id: String) -> Result<(), String> {
+    tauri::async_runtime::spawn_blocking(move || {
+        let state = app.state::<SpeechState>();
+        let mut registry = state
+            .live
+            .lock()
+            .map_err(|_| "Speech session lock failed")?;
+        if registry.requested.as_deref() == Some(&session_id) {
+            registry.requested = None;
+            registry.session = None;
+        }
+        Ok(())
+    })
+    .await
+    .map_err(|error| error.to_string())?
+}
