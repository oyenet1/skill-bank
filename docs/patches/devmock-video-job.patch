diff --git a/src/components/VideoCaptionEditor.vue b/src/components/VideoCaptionEditor.vue
new file mode 100644
--- /dev/null
+++ b/src/components/VideoCaptionEditor.vue
@@ -0,0 +1,139 @@
+<script setup lang="ts">
+import { Channel, convertFileSrc, invoke, isTauri } from '@tauri-apps/api/core';
+import { computed, onMounted, ref } from 'vue';
+
+type CaptionCue = { start: number; end: number; text: string };
+type CaptionDraft = {
+  duration_sec: number;
+  cues: CaptionCue[];
+  review_required: boolean;
+  videoSha256: string;
+  captionSha256: string;
+  source?: string;
+  model?: string;
+};
+type ReviewResult = { ready: boolean; review_required: boolean; captionSha256: string; cues: CaptionCue[]; reviewedTranscript: string };
+
+const props = defineProps<{ directory: string; video: string; reviewRequired: boolean }>();
+const emit = defineEmits<{ reviewed: [transcript: string] }>();
+const draft = ref<CaptionDraft | null>(null);
+const busy = ref(false);
+const saving = ref(false);
+const error = ref('');
+const message = ref('');
+const preview = computed(() => isTauri() ? convertFileSrc(props.video) : '');
+const formatTime = (seconds: number) => `${Math.floor(seconds / 60)}:${Math.floor(seconds % 60).toString().padStart(2, '0')}`;
+
+async function loadCaptions() {
+  if (!isTauri() || busy.value) return;
+  busy.value = true;
+  error.value = '';
+  message.value = 'Loading timed captions…';
+  try {
+    const onProgress = new Channel<{ phase: string; percent: number; message: string }>();
+    onProgress.onmessage = (event) => { message.value = event.message; };
+    draft.value = await invoke<CaptionDraft>('video_skill_caption_review', {
+      directory: props.directory,
+      onProgress,
+    });
+    message.value = `${draft.value.cues.length} caption cues · ${formatTime(draft.value.duration_sec)} video`;
+  } catch (reason) {
+    error.value = reason instanceof Error ? reason.message : String(reason);
+    message.value = '';
+  } finally {
+    busy.value = false;
+  }
+}
+
+function addCue() {
+  const current = draft.value;
+  if (!current || current.cues.length >= 20_000) return;
+  const start = current.cues.at(-1)?.end ?? 0;
+  const end = Math.min(start + 1.5, current.duration_sec);
+  if (end - start < 0.001) {
+    error.value = 'There is no unused time after the final caption. Adjust a cue first.';
+    return;
+  }
+  error.value = '';
+  current.cues.push({ start, end, text: '' });
+}
+
+function removeCue(index: number) {
+  draft.value?.cues.splice(index, 1);
+  error.value = '';
+}
+
+async function saveCaptions() {
+  const current = draft.value;
+  if (!current || saving.value || !isTauri()) return;
+  saving.value = true;
+  error.value = '';
+  message.value = 'Saving caption files…';
+  try {
+    const onProgress = new Channel<{ phase: string; percent: number; message: string }>();
+    onProgress.onmessage = (event) => { message.value = event.message; };
+    const saved = await invoke<ReviewResult>('video_skill_caption_review', {
+      directory: props.directory,
+      edits: {
+        duration_sec: current.duration_sec,
+        cues: current.cues,
+        videoSha256: current.videoSha256,
+      },
+      expectedCaptionSha: current.captionSha256,
+      onProgress,
+    });
+    draft.value = { ...current, ...saved };
+    message.value = 'Reviewed captions saved as JSON, SRT, and VTT.';
+    emit('reviewed', saved.reviewedTranscript);
+  } catch (reason) {
+    error.value = reason instanceof Error ? reason.message : String(reason);
+    message.value = '';
+  } finally {
+    saving.value = false;
+  }
+}
+
+onMounted(loadCaptions);
+</script>
+
+<template>
+  <section class="space-y-3 rounded-xl border border-default bg-default p-4 sm:p-5">
+    <div class="flex flex-wrap items-start justify-between gap-2">
+      <div>
+        <h3 class="text-sm font-semibold text-highlighted">Timed captions</h3>
+        <p class="mt-1 text-xs text-muted">Play the final video, correct each caption, and adjust its start and end in seconds.</p>
+      </div>
+      <span v-if="reviewRequired && draft?.review_required" class="rounded-full bg-warning/10 px-2 py-1 text-[11px] text-warning">Review needed</span>
+    </div>
+
+    <video v-if="preview" :src="preview" controls preload="metadata" class="max-h-72 w-full rounded-lg bg-black" aria-label="Final video caption preview" />
+
+    <p v-if="message" class="text-xs text-muted" role="status">{{ message }}</p>
+    <UAlert v-if="error" color="error" variant="subtle" icon="i-lucide-circle-alert" :description="error" />
+
+    <div v-if="draft" class="max-h-[34rem] space-y-2 overflow-y-auto pr-1">
+      <article v-for="(cue, index) in draft.cues" :key="index" class="grid gap-2 rounded-lg border border-default p-3 md:grid-cols-[5rem_1fr_2.5rem]">
+        <p class="pt-2 text-xs font-medium text-muted">#{{ index + 1 }}</p>
+        <div class="space-y-2">
+          <UTextarea v-model="cue.text" :rows="2" :disabled="saving" :aria-label="`Caption ${index + 1} text`" placeholder="Caption text…" class="w-full" />
+          <div class="grid grid-cols-2 gap-2">
+            <UFormField label="Start (seconds)">
+              <UInput v-model.number="cue.start" type="number" min="0" :max="draft.duration_sec" step="0.01" :disabled="saving" class="w-full" />
+            </UFormField>
+            <UFormField label="End (seconds)">
+              <UInput v-model.number="cue.end" type="number" min="0" :max="draft.duration_sec" step="0.01" :disabled="saving" class="w-full" />
+            </UFormField>
+          </div>
+        </div>
+        <UButton icon="i-lucide-trash-2" color="error" variant="ghost" size="xs" :disabled="saving" :aria-label="`Remove caption ${index + 1}`" @click="removeCue(index)" />
+      </article>
+      <p v-if="!draft.cues.length" class="rounded-lg border border-dashed border-default p-4 text-center text-xs text-muted">No caption cues. Add a cue if this video has speech.</p>
+    </div>
+
+    <div class="flex flex-wrap gap-2">
+      <UButton label="Add caption" icon="i-lucide-plus" color="neutral" variant="soft" size="sm" :disabled="!draft || saving" @click="addCue" />
+      <UButton :label="saving ? 'Saving…' : 'Save reviewed captions'" icon="i-lucide-save" color="primary" size="sm" :loading="saving" :disabled="!draft || busy || saving" @click="saveCaptions" />
+      <UButton label="Reload" icon="i-lucide-refresh-cw" color="neutral" variant="ghost" size="sm" :disabled="busy || saving" @click="loadCaptions" />
+    </div>
+  </section>
+</template>
diff --git a/src/components/LocalAvatarPanel.vue b/src/components/LocalAvatarPanel.vue
new file mode 100644
