+beforeEach(() => {
+  vi.stubGlobal('localStorage', { getItem: () => null, setItem: vi.fn() });
+  setActivePinia(createPinia());
+});
+afterEach(() => vi.unstubAllGlobals());
+
+describe('storyboard timeline actions', () => {
+  it('adds the current mockup as a new independent slide', () => {
+    const store = useMockupStore();
+    store.singleImageSrc = 'fixture-image'; store.typography.headlineText = 'A new scene';
+    store.addStoryboardSlide();
+    expect(store.storyboardSlides).toHaveLength(2);
+    expect(store.activeSlideIndex).toBe(1);
+    expect(store.storyboardSlides[1].headline).toBe('A new scene');
+    expect(store.storyboardSlides[1].imageSrc).toBe('fixture-image');
+    expect(store.storyboardSlides[1].id).not.toBe(store.storyboardSlides[0].id);
